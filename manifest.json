{
    "manifest_version": 3,
    "name": "LinkedIn Follow-Up Tracker",
    "version": "2.1.0",
    "description": "Track LinkedIn connections, auto-calculate follow-ups, and manage outreach from Google Sheets.",
    "action": {
        "default_popup": "popup.html"
    },
    "background": {
        "service_worker": "background.js"
    },
    "permissions": [
        "identity",
        "storage",
        "alarms",
        "notifications",
        "tabs",
        "idle"
    ],
    "host_permissions": [
        "https://www.linkedin.com/*",
        "https://sheets.googleapis.com/*"
    ],
    "oauth2": {
        "client_id": "954030658876-2v73ctjpsus51cmkg5ssu09tob2fnd0n.apps.googleusercontent.com",
        "scopes": [
            "https://www.googleapis.com/auth/drive.file"
        ]
    },
    "web_accessible_resources": [
        {
            "resources": ["tea.gif"],
            "matches": ["https://www.linkedin.com/*"]
        }
    ],
    "content_scripts": [
        {
            "matches": [
                "https://www.linkedin.com/mynetwork/invitation-manager/sent/*"
            ],
            "js": [
                "content.js"
            ]
        },
        {
            "matches": [
                "https://www.linkedin.com/mynetwork/invite-connect/connections/*"
            ],
            "js": [
                "connections.js"
            ]
        },
        {
            "matches": [
                "https://www.linkedin.com/messaging/*"
            ],
            "js": [
                "messaging.js"
            ]
        }
    ]
}   